namespace pdfium_bridge {
    void init_engine();
    void destroy_engine();
    
    [Throws=PdfiumError]
    DocumentHandle load_document(i32 fd);
    
    [Throws=PdfiumError]
    void close_document(DocumentHandle handle);
    
    [Throws=PdfiumError]
    i32 get_page_count(DocumentHandle handle);
    
    [Throws=PdfiumError]
    PageRender render_page(DocumentHandle handle, i32 page_index, RenderConfig config);
    
    [Throws=PdfiumError]
    string extract_text(DocumentHandle handle, i32 page_index);
};

[Custom]
typedef u64 DocumentHandle;

[Error]
enum PdfiumError {
    "InvalidFd",
    "FileEmpty",
    "MmapFailed",
    "LoadFailed",
    "Oom",
    "InvalidHandle",
    "PageOutOfRange",
    "PageLoadFailed",
    "RenderFailed",
    "TextExtractionFailed",
    "EngineNotInitialized",
    "BitmapError"
};

dictionary RenderConfig {
    u32 width;
    u32 height;
    u32 stride;
    u64 native_env;      // JNIEnv* as opaque u64
    u64 native_bitmap;   // jobject bitmap as opaque u64
};

dictionary PageRender {
    boolean success;
    string? error;
};
